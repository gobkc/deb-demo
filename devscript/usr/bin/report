#!/bin/bash

# 找到 CHANGELOG 文件
if [ -f "CHANGELOG.md" ]; then
    changelog_file="CHANGELOG.md"
elif [ -f "changelog.md" ]; then
    changelog_file="changelog.md"
else
    echo "未找到 CHANGELOG 文件。"
    exit 1
fi

# 提取版本列表（版本号后可带说明，如 v4.0.3-tawteen-mixedmanual 或 v4.0.3）
versions=$(grep -E '^###\s+[0-9a-zA-Z]+\.[0-9]+\.[0-9]+' "$changelog_file" | awk '{print $2}')

# 提示用户选择版本
echo "请选择要提取的版本："
selected_version=$(echo "$versions" | peco --prompt "Version> " --initial-index=0)

# 提取版本行（可能带 db 描述）与版本块内容，仅到下一个版本块（只比对版本号字段，兼容版本行上的附加描述）
version_header=$(awk -v ver="$selected_version" '
    $1 == "###" && $2 == ver {print; exit}
' "$changelog_file")

version_content=$(awk -v ver="$selected_version" '
    $1 == "###" && $2 == ver {found=1; next}
    /^### / && found {exit}
    found {print}
' "$changelog_file")

# 提取 db 描述，如 db:70
db_tag=$(printf '%s\n%s\n' "$version_header" "$version_content" | grep -oE 'db:[[:space:]]*[0-9]+' | head -n 1 | tr -d '[:space:]')

# 仅提取以 `-` 开头的行
mapfile -t items <<< "$(echo "$version_content" | grep -E '^\s*-\s+')"

# 格式化内容
formatted_content=""
for i in "${!items[@]}"; do
    formatted_content+="$((i+1)). ${items[$i]:2}\n"
done

# 定义项目列表
projects="configurator-be\nconfigurator-be-v2\nprofile-be\nelevate-be"

# 检查是否安装了xclip
if ! command -v xclip > /dev/null 2>&1; then
    echo "xclip 未安装，正在安装..."

    # 更新apt包索引并安装xclip
    sudo apt update
    sudo apt install -y xclip

    echo "xclip 安装完成！"
else
    echo "xclip 已经安装。"
fi

# 提示用户选择项目
echo "请选择项目："
selected_project=$(echo -e "$projects" | peco --prompt "Project> ")
echo "$selected_project"

# 组装标题（版本号后单独一行显示 db 描述）
title="$selected_project $selected_version"
if [ -n "$db_tag" ]; then
    title+="\n$db_tag"
fi

echo -e "该tag的报告如下：\n"
echo -e "$title\n$formatted_content"
echo -e "\n以上内容已放入剪贴板，请按下ctrl + v粘贴内容"
echo -e "$title\n$formatted_content"|xclip -selection clipboard
